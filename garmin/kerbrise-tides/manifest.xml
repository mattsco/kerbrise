<?xml version="1.0" encoding="UTF-8"?>
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <!--
      Widget "Marées Kerbrise" — affiche les marées de Saint-Malo (offline).
      Aucune permission : la donnée est embarquée (TideData.mc), zéro réseau.
      id : généré une fois, à NE PAS réutiliser pour une autre app.
    -->
    <iq:application
        entry="KerbriseTidesApp"
        id="41ce11b208e74212a586a728691ecb8f"
        launcherIcon="@Drawables.LauncherIcon"
        minApiLevel="3.2.0"
        name="@Strings.AppName"
        type="widget">

        <iq:products>
            <!-- FR255 (non-music) et 255S = ta montre (Small). Music inclus par sûreté. -->
            <iq:product id="fr255"/>
            <iq:product id="fr255s"/>
            <iq:product id="fr255m"/>
            <iq:product id="fr255sm"/>
        </iq:products>

        <iq:permissions/>

        <iq:barrels/>
    </iq:application>
</iq:manifest>
